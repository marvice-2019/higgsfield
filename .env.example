# --- Required ---
# Postgres connection string (Coolify: the internal Postgres URL of your Postgres resource)
DATABASE_URL=
# Public URL of the app, used for same-origin checks on every write request
APP_URL=https://higgsfield.marvice.tech
# Higgsfield API credentials from https://console.higgsfield.ai (Key ID + Secret)
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# First admin, created on first boot only if no admin exists yet (min 10 chars)
ADMIN_EMAIL=yuvarajgs@marvice.in
# Display name for that admin (kept in sync on every boot)
ADMIN_NAME=Yuvaraj
ADMIN_PASSWORD=

# --- Optional ---
# Where generated files are stored (mount a persistent volume here)
MEDIA_DIR=/data/media
# Generations per user per day (IST). Admins get ADMIN_DAILY_LIMIT.
DAILY_LIMIT=25
ADMIN_DAILY_LIMIT=100
# Max jobs one user can have running at once
MAX_ACTIVE_PER_USER=3
# Session length in days
SESSION_DAYS=14
